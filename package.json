{
  "name": "forkity-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "parcel index.html",
    "build": "parcel build index.html",
    "dev:api": "node --watch src/server.js",
    "start:api": "node src/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node-pg-migrate -m migrations up",
    "db:rollback": "node-pg-migrate -m migrations down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "core-js": "^3.41.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "parcel": "^2.14.4"
  }
}
